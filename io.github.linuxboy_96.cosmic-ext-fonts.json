{
  "$schema": "https://raw.githubusercontent.com/flatpak/flatpak-builder/main/data/flatpak-manifest.schema.json",
  "id": "io.github.linuxboy_96.cosmic-ext-fonts",
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "25.08",
  "base": "com.system76.Cosmic.BaseApp",
  "base-version": "stable",
  "sdk": "org.freedesktop.Sdk",
  "sdk-extensions": [
    "org.freedesktop.Sdk.Extension.rust-stable"
  ],
  "command": "cosmic-ext-fonts",
  "finish-args": [
    "--socket=wayland",
    "--share=network",
    "--filesystem=xdg-data/fonts:create",
    "--filesystem=xdg-config/cosmic:ro",
    "--talk-name=com.system76.CosmicSettingsDaemon",
    "--talk-name=com.system76.CosmicSettingsDaemon.*"
  ],
  "build-options": {
    "append-path": "/usr/lib/sdk/rust-stable/bin",
    "env": {
      "CARGO_HOME": "/run/build/cosmic-ext-fonts/cargo"
    }
  },
  "modules": [
    {
      "name": "cosmic-ext-fonts",
      "buildsystem": "simple",
      "build-commands": [
        "cargo --offline build --release --locked",
        "install -Dm0755 target/release/cosmic-ext-fonts -t /app/bin/",
        "install -Dm0644 res/app.desktop /app/share/applications/io.github.linuxboy_96.cosmic-ext-fonts.desktop",
        "install -Dm0644 res/metainfo.xml /app/share/metainfo/io.github.linuxboy_96.cosmic-ext-fonts.metainfo.xml",
        "install -Dm0644 res/icons/hicolor/scalable/apps/io.github.linuxboy_96.cosmic-ext-fonts.svg -t /app/share/icons/hicolor/scalable/apps/"
      ],
      "sources": [
        {
          "type": "dir",
          "path": "./",
          "skip": [
            "target",
            ".flatpak-builder"
          ]
        },
        "cargo-sources.json"
      ]
    }
  ]
}
