[Desktop Entry]
Name=Fonts
Name[fr]=Polices
Name[de]=Schriften
Name[es]=Fuentes
Name[it]=Caratteri
Name[pt]=Fontes
Name[nl]=Lettertypen
Comment=Font manager
Comment[fr]=Gestionnaire de polices
Comment[de]=Schriftenverwaltung
Comment[es]=Gestor de fuentes
Comment[it]=Gestore dei caratteri
Comment[pt]=Gestor de fontes
Comment[nl]=Lettertypebeheer
Exec=cosmic-ext-fonts %f
Terminal=false
Type=Application
StartupNotify=true
Icon=io.github.linuxboy_96.cosmic-ext-fonts
Categories=COSMIC;Utility;
Keywords=font;fonts;typeface;typography;ttf;otf;
Keywords[fr]=police;polices;typographie;
Keywords[de]=Schrift;Schriftart;Typografie;
Keywords[es]=fuente;tipografía;
Keywords[it]=carattere;font;tipografia;
Keywords[pt]=fonte;tipografia;
Keywords[nl]=lettertype;typografie;
MimeType=font/ttf;font/otf;application/x-font-ttf;application/x-font-otf;application/font-sfnt;application/vnd.ms-opentype;font/collection;
